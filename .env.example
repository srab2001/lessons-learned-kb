# Lessons Learned KB — environment variables
#
# This app has NO database connection of its own. It is a static markdown
# knowledge base (built by MkDocs into wiki/site/, served by Vercel) plus a
# small Google-OAuth gate in middleware.js + api/auth/. There is no
# DATABASE_URL / POSTGRES_URL / Postgres connection anywhere in this repo.
#
# (For context: the template this repo was bootstrapped from,
# proposal-intelligence-kb, has a companion Vercel app called
# solution-architecture that owns a Neon Postgres database and ingests this
# KB's public pages into it. No equivalent companion app exists for this KB.
# If one is built later, its DATABASE_URL / POSTGRES_URL lives in THAT app's
# environment, not this one.)

# --- Google OAuth (KB sign-in) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# HMAC signing secret for the kb_session cookie. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=replace-with-a-random-secret

# Comma-separated allow-list of emails permitted to sign in.
# Leave unset to allow any Google-authenticated user.
ALLOWED_KB_EMAILS=

# Base URL this app is deployed at (used to build the OAuth redirect_uri).
KB_BASE_URL=https://lessons-learned-kb.vercel.app

# Optional shared-secret bypass for server-to-server access (sent as the
# x-kb-token request header instead of a browser session cookie). Leave
# unset to disable this bypass entirely.
KB_ACCESS_TOKEN=
